BROKER_HOST=
BROKER_PORT=5672
USER=
PASSWORD=
VHOST=project
QUEUE=admin_queue
RESPONSE_TIMEOUT=10

; Optional exploration:
; Uncomment these to route through a named exchange instead of publishing
; directly to the queue through RabbitMQ's default exchange.
EXCHANGE=admin_exchange
EXCHANGE_TYPE=direct
; ROUTING_KEY=sample.request